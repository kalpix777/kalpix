# Kalpix environment template. Copy to .env and fill locally. NEVER commit .env.
# Server-side only. Nothing here may be exposed to browser code unless prefixed NEXT_PUBLIC_.

# --- Runtime ---
APP_ENV=development            # development | staging | production
APP_NAME=Kalpix
APP_URL=http://localhost:3000

# --- Database (local Docker Postgres by default) ---
POSTGRES_USER=kalpix
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=kalpix_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kalpix:change-me-locally@localhost:5432/kalpix_dev

# --- Auth (Phase 2) ---
AUTH_SECRET=                   # generate: openssl rand -base64 32

# --- AI providers (Phase 5+; all optional, adapters stay disabled when empty) ---
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Discovery and research (Phase 3-4) ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=       # required by Nominatim usage policy
GOOGLE_PLACES_API_KEY=         # paid, disabled until approved
FIRECRAWL_API_KEY=             # paid, disabled until approved

# --- Messaging (Phase 11) ---
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Payments (Phase 13, test mode first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Hosting (Phase 10) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- First owner (used once by `pnpm db:seed`, then remove) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=           # 12+ characters
SEED_OWNER_NAME=Owner
REQUIRE_ADMIN_MFA=             # true|false; defaults to true in production
BREVO_API_KEY=
VPS_SSH_HOST=
