# Kalpix environment template. Copy to .env and fill locally. NEVER commit .env.
# Server-side only. Nothing here may be exposed to browser code unless prefixed NEXT_PUBLIC_.

# --- Runtime ---
APP_ENV=development            # development | staging | production
APP_NAME=Kalpix
APP_URL=http://localhost:3000

# --- Database (local Docker Postgres by default) ---
POSTGRES_USER=kalpix
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=kalpix_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kalpix:change-me-locally@localhost:5432/kalpix_dev

# --- Auth (Phase 2) ---
AUTH_SECRET=                   # generate: openssl rand -base64 32

# --- AI providers (Phase 5+; all optional, adapters stay disabled when empty) ---
OLLAMA_BASE_URL=http://localhost:11434   # local Ollama; needs suitable hardware (pnpm doctor)
OLLAMA_MODEL=                  # default llama3.2:3b; check the model's licence
GEMINI_API_KEY=                # server-only. Free tier: Google may use prompts for training
GEMINI_MODEL=                  # default gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Discovery and research (Phase 3-4) ---
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT_EMAIL=       # required by Nominatim usage policy
GOOGLE_PLACES_API_KEY=         # paid, disabled until approved
FIRECRAWL_API_KEY=             # paid, disabled until approved
DISCOVERY_PROVIDER=overpass    # overpass | mock | google_places (mock refused in production; google_places not built yet)
DISCOVERY_MAX_BBOX_DEG2=0.25   # largest search box in square degrees (Overpass fair use)
NOMINATIM_COUNTRY_CODES=in     # ISO alpha-2, comma separated; limits place-name geocoding
RESEARCH_PROVIDER=http         # http | mock (Phase 4 website research; mock refused in production)
RESEARCH_MAX_PAGES=5           # pages per website: homepage + likely contact/about pages (1-20)
RESEARCH_HOST_DELAY_MS=2000    # min delay between requests to one host, min 2000; robots Crawl-delay wins if larger
RESEARCH_USER_AGENT_CONTACT=   # email or URL shown in the KalpixBot User-Agent (required in production)

# --- Verification and qualification (Phase 5) ---
QUALIFICATION_AI_PROVIDER=none # none | mock | ollama | gemini. none = rules-only scoring (mock refused in production)
QUALIFICATION_PROMPT_VERSION=qual-v1  # stored with every AI result
VERIFICATION_DNS_TIMEOUT_MS=3000      # MX lookup timeout for email verification (200-30000)

# --- CRM and lead management (Phase 6; no outbound messaging until Phases 11-12) ---
CRM_STALE_DAYS=14            # an open lead with no activity for this many days is "stale" (1-365)
CRM_PROMOTE_TIERS=hot,warm   # qualification tiers promoted to leads by default (hot, warm, cold; never disqualified)

# --- Worker (Phase 3: pnpm worker / pnpm worker:once) ---
WORKER_POLL_INTERVAL_MS=5000   # queue poll interval, min 1000

# --- Messaging (Phase 11) ---
RESEND_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Payments (Phase 13, test mode first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Hosting (Phase 10) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- First owner (used once by `pnpm db:seed`, then remove) ---
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=           # 12+ characters
SEED_OWNER_NAME=Owner
REQUIRE_ADMIN_MFA=             # true|false; defaults to true in production
BREVO_API_KEY=
VPS_SSH_HOST=
