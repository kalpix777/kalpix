{
  "name": "@kalpix/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "once": "dotenv -e ../../.env -- tsx src/index.ts --once",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "dotenv -e ../../.env -- vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@kalpix/core": "workspace:*",
    "@kalpix/providers": "workspace:*",
    "@prisma/client": "~6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
