// Kalpix schema (Phase 2 core + Phase 3 discovery). Auth tables follow Better Auth 1.7 (core + twoFactor + admin plugins).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Better Auth) ----------
model User {
  id               String         @id
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  twoFactorEnabled Boolean?       @default(false)
  role             String?        @default("viewer")
  banned           Boolean?       @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  auditLogs        AuditLog[]
  discoveryRuns    DiscoveryRun[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------- Platform ----------
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String // email or "system"; survives user deletion
  action     String // e.g. "auth.sign_in", "settings.update", "provider.toggle"
  entityType String?
  entityId   String?
  ipAddress  String?
  metadata   Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

enum ProviderCategory {
  discovery
  research
  model
  email
  whatsapp
  payment
  hosting
  storage
}

enum CostTier {
  free
  freemium
  paid
}

model ProviderConfig {
  id                    String           @id // matches adapter descriptor id, e.g. "osm-overpass"
  name                  String
  category              ProviderCategory
  costTier              CostTier
  enabled               Boolean          @default(false)
  commercialUseVerified Boolean          @default(false)
  requiredSecrets       String[] // env var NAMES only, never values
  fallbackProviderId    String?
  monthlyLimitUnits     Int?
  monthlyBudgetMinor    Int? // in currency minor units (paise)
  currency              String           @default("INR")
  notes                 String?
  lastHealthStatus      String? // connected | not_configured | error | disabled
  lastHealthCheckedAt   DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  usageEvents           UsageEvent[]

  @@map("provider_config")
}

model UsageEvent {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now())
  providerId String
  provider   ProviderConfig @relation(fields: [providerId], references: [id])
  operation  String
  units      Int            @default(1)
  costMinor  Int            @default(0)
  currency   String         @default("INR")
  isEstimate Boolean        @default(true)
  entityType String?
  entityId   String?

  @@index([providerId, createdAt])
  @@map("usage_event")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_setting")
}

enum BillingCycle {
  one_time
  monthly
  yearly
}

model ServicePackage {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  category     String // development | redesign | hosting | maintenance | seo | content | automation | support
  billingCycle BillingCycle
  priceMinor   Int // configurable, never hardcoded in code
  currency     String       @default("INR")
  taxRateBps   Int          @default(1800) // 18% GST default, editable
  active       Boolean      @default(true)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("service_package")
}

// ---------- Phase 3: business discovery ----------
enum DiscoveryRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// One discovery job. A DB-backed queue: apps/worker claims queued (or stale running) rows with
/// FOR UPDATE SKIP LOCKED, processes one category at a time and records progress, so a crashed
/// run resumes where it stopped. Upserts on (provider, providerId) make re-processing idempotent.
model DiscoveryRun {
  id                  String             @id @default(uuid())
  area                String // as typed: "Belagavi, Karnataka" or "south,west,north,east"
  categories          String[]
  provider            String // provider descriptor id, e.g. "osm-overpass"
  status              DiscoveryRunStatus @default(queued)
  idempotencyKey      String?            @unique
  // resolved area (stored so a resumed run never geocodes twice)
  areaDisplayName     String?
  areaSource          String?
  bboxSouth           Float?
  bboxWest            Float?
  bboxNorth           Float?
  bboxEast            Float?
  // progress + counts
  completedCategories String[]           @default([])
  foundCount          Int                @default(0) // usable candidates returned
  createdCount        Int                @default(0) // new Business rows
  updatedCount        Int                @default(0) // existing rows refreshed (same provider id)
  duplicateCount      Int                @default(0) // merged into an existing row by fuzzy match
  skippedCount        Int                @default(0) // unnamed / unclassifiable elements
  requestCount        Int                @default(0) // HTTP requests made to providers
  attempts            Int                @default(0)
  error               String?
  attribution         String?
  // who and when
  startedById         String?
  startedBy           User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedByLabel      String
  lockedBy            String?
  lockedAt            DateTime?
  createdAt           DateTime           @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("discovery_run")
}

enum BusinessStatus {
  NEW
  REVIEWED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

/// A discovered business with provenance (docs/ARCHITECTURE.md "Data provenance").
model Business {
  id                 String         @id @default(uuid())
  name               String
  normalizedName     String
  category           String // Kalpix industry id, e.g. "restaurants"
  subcategory        String? // matched provider tag, e.g. "amenity=cafe"
  provider           String // "osm-overpass" | "mock-discovery" | ...
  providerId         String // "node/123" for OSM
  osmType            String?
  osmId              String?
  alternateIds       String[]       @default([]) // provider:id of records merged by fuzzy dedupe
  // address
  houseNumber        String?
  street             String?
  locality           String?
  city               String?
  district           String?
  state              String?
  postcode           String?
  country            String?
  addressFull        String?
  lat                Float
  lon                Float
  // contact
  phone              String?
  website            String?
  email              String?
  openingHours       String?
  hasWebsite         Boolean        @default(false)
  // provenance
  source             String // "openstreetmap" | "mock"
  sourceType         String // open_data | licensed_api | mock
  sourceUrl          String
  collectedAt        DateTime
  lastSeenAt         DateTime
  confidence         Float // completeness heuristic 0..1, not a verification
  verificationStatus String         @default("unverified")
  license            String?
  usageRestrictions  String?
  rawTags            Json?
  firstRunId         String?
  lastRunId          String?
  status             BusinessStatus @default(NEW)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([provider, providerId])
  @@index([category])
  @@index([hasWebsite])
  @@index([status])
  @@index([lat, lon])
  @@index([createdAt])
  @@map("business")
}

/// Nominatim results cached across processes (usage policy: cache, never bulk-geocode).
model GeocodeCache {
  key         String   @id // normalised query
  query       String
  provider    String
  displayName String
  south       Float
  west        Float
  north       Float
  east        Float
  sourceUrl   String?
  fetchedAt   DateTime @default(now())

  @@map("geocode_cache")
}
