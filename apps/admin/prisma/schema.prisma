// Kalpix schema (Phase 2 core + Phase 3 discovery + Phase 4 research + Phase 5 qualification + Phase 6 CRM). Auth tables follow Better Auth 1.7 (core + twoFactor + admin plugins).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Better Auth) ----------
model User {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  twoFactorEnabled  Boolean?           @default(false)
  role              String?            @default("viewer")
  banned            Boolean?           @default(false)
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  auditLogs         AuditLog[]
  discoveryRuns     DiscoveryRun[]
  researchRuns      ResearchRun[]
  qualificationRuns QualificationRun[]
  verifiedFacts     ResearchFact[]
  // Phase 6 CRM
  leadsAssigned     Lead[]             @relation("LeadAssignee")
  leadsCreated      Lead[]             @relation("LeadCreatedBy")
  leadStageChanges  LeadStageHistory[]
  leadActivities    LeadActivity[]
  leadTasksAssigned LeadTask[]         @relation("LeadTaskAssignee")
  leadTasksCreated  LeadTask[]         @relation("LeadTaskCreatedBy")
  leadTasksDone     LeadTask[]         @relation("LeadTaskCompletedBy")
  contactStatusSet  Business[]         @relation("BusinessContactStatusBy")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------- Platform ----------
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String // email or "system"; survives user deletion
  action     String // e.g. "auth.sign_in", "settings.update", "provider.toggle"
  entityType String?
  entityId   String?
  ipAddress  String?
  metadata   Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_log")
}

enum ProviderCategory {
  discovery
  research
  model
  email
  whatsapp
  payment
  hosting
  storage
}

enum CostTier {
  free
  freemium
  paid
}

model ProviderConfig {
  id                    String           @id // matches adapter descriptor id, e.g. "osm-overpass"
  name                  String
  category              ProviderCategory
  costTier              CostTier
  enabled               Boolean          @default(false)
  commercialUseVerified Boolean          @default(false)
  requiredSecrets       String[] // env var NAMES only, never values
  fallbackProviderId    String?
  monthlyLimitUnits     Int?
  monthlyBudgetMinor    Int? // in currency minor units (paise)
  currency              String           @default("INR")
  notes                 String?
  lastHealthStatus      String? // connected | not_configured | error | disabled
  lastHealthCheckedAt   DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  usageEvents           UsageEvent[]

  @@map("provider_config")
}

model UsageEvent {
  id         String         @id @default(uuid())
  createdAt  DateTime       @default(now())
  providerId String
  provider   ProviderConfig @relation(fields: [providerId], references: [id])
  operation  String
  units      Int            @default(1)
  costMinor  Int            @default(0)
  currency   String         @default("INR")
  isEstimate Boolean        @default(true)
  entityType String?
  entityId   String?

  @@index([providerId, createdAt])
  @@map("usage_event")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("system_setting")
}

enum BillingCycle {
  one_time
  monthly
  yearly
}

model ServicePackage {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  description  String?
  category     String // development | redesign | hosting | maintenance | seo | content | automation | support
  billingCycle BillingCycle
  priceMinor   Int // configurable, never hardcoded in code
  currency     String       @default("INR")
  taxRateBps   Int          @default(1800) // 18% GST default, editable
  active       Boolean      @default(true)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("service_package")
}

// ---------- Phase 3: business discovery ----------
enum DiscoveryRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// One discovery job. A DB-backed queue: apps/worker claims queued (or stale running) rows with
/// FOR UPDATE SKIP LOCKED, processes one category at a time and records progress, so a crashed
/// run resumes where it stopped. Upserts on (provider, providerId) make re-processing idempotent.
model DiscoveryRun {
  id                  String             @id @default(uuid())
  area                String // as typed: "Belagavi, Karnataka" or "south,west,north,east"
  categories          String[]
  provider            String // provider descriptor id, e.g. "osm-overpass"
  status              DiscoveryRunStatus @default(queued)
  idempotencyKey      String?            @unique
  // resolved area (stored so a resumed run never geocodes twice)
  areaDisplayName     String?
  areaSource          String?
  bboxSouth           Float?
  bboxWest            Float?
  bboxNorth           Float?
  bboxEast            Float?
  // progress + counts
  completedCategories String[]           @default([])
  foundCount          Int                @default(0) // usable candidates returned
  createdCount        Int                @default(0) // new Business rows
  updatedCount        Int                @default(0) // existing rows refreshed (same provider id)
  duplicateCount      Int                @default(0) // merged into an existing row by fuzzy match
  skippedCount        Int                @default(0) // unnamed / unclassifiable elements
  requestCount        Int                @default(0) // HTTP requests made to providers
  attempts            Int                @default(0)
  error               String?
  attribution         String?
  // who and when
  startedById         String?
  startedBy           User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedByLabel      String
  lockedBy            String?
  lockedAt            DateTime?
  createdAt           DateTime           @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("discovery_run")
}

enum BusinessStatus {
  NEW
  REVIEWED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

/// A discovered business with provenance (docs/ARCHITECTURE.md "Data provenance").
model Business {
  id                   String                  @id @default(uuid())
  name                 String
  normalizedName       String
  category             String // Kalpix industry id, e.g. "restaurants"
  subcategory          String? // matched provider tag, e.g. "amenity=cafe"
  provider             String // "osm-overpass" | "mock-discovery" | ...
  providerId           String // "node/123" for OSM
  osmType              String?
  osmId                String?
  alternateIds         String[]                @default([]) // provider:id of records merged by fuzzy dedupe
  // address
  houseNumber          String?
  street               String?
  locality             String?
  city                 String?
  district             String?
  state                String?
  postcode             String?
  country              String?
  addressFull          String?
  lat                  Float
  lon                  Float
  // contact
  phone                String?
  website              String?
  email                String?
  openingHours         String?
  hasWebsite           Boolean                 @default(false)
  // provenance
  source               String // "openstreetmap" | "mock"
  sourceType           String // open_data | licensed_api | mock
  sourceUrl            String
  collectedAt          DateTime
  lastSeenAt           DateTime
  confidence           Float // completeness heuristic 0..1, not a verification
  verificationStatus   String                  @default("unverified")
  license              String?
  usageRestrictions    String?
  rawTags              Json?
  firstRunId           String?
  lastRunId            String?
  status               BusinessStatus          @default(NEW)
  lastResearchedAt     DateTime? // Phase 4: last website research of any outcome
  // Phase 5: latest rules-based qualification (for listing); history in business_qualification
  latestScore          Int?
  latestTier           String? // hot | warm | cold | disqualified
  qualifiedAt          DateTime?
  // Phase 6: consent / do-not-contact (DPDP Act). Anything but "ok" blocks future outreach.
  contactStatus        ContactStatus           @default(ok)
  contactStatusReason  String?
  contactStatusById    String?
  contactStatusBy      User?                   @relation("BusinessContactStatusBy", fields: [contactStatusById], references: [id], onDelete: SetNull)
  contactStatusByLabel String? // email or "system"; survives user deletion
  contactStatusAt      DateTime?
  lawfulBasisNote      String? // why Kalpix may process this business's contact data
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  researches           BusinessResearch[]
  facts                ResearchFact[]
  qualifications       BusinessQualification[]
  lead                 Lead?

  @@unique([provider, providerId])
  @@index([category])
  @@index([hasWebsite])
  @@index([status])
  @@index([lat, lon])
  @@index([createdAt])
  @@index([latestTier, latestScore])
  @@map("business")
}

/// Nominatim results cached across processes (usage policy: cache, never bulk-geocode).
model GeocodeCache {
  key         String   @id // normalised query
  query       String
  provider    String
  displayName String
  south       Float
  west        Float
  north       Float
  east        Float
  sourceUrl   String?
  fetchedAt   DateTime @default(now())

  @@map("geocode_cache")
}

// ---------- Phase 4: business research and extraction ----------

enum ResearchRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// One website-research job; also the worker's queue (job type "research", same claim mechanism
/// as discovery_run). Scope: explicit business ids, all businesses of a discovery run, or a filter.
model ResearchRun {
  id             String             @id @default(uuid())
  provider       String // provider descriptor id: "http-extractor" | "mock-research"
  status         ResearchRunStatus  @default(queued)
  idempotencyKey String?            @unique
  scopeType      String // businesses | discovery_run | filter
  businessIds    String[]           @default([]) // scopeType=businesses
  discoveryRunId String? // scopeType=discovery_run
  filter         Json? // scopeType=filter (validated by parseResearchFilter)
  // resolved once, so a resumed run researches exactly the same businesses
  targetIds      String[]           @default([])
  resolvedAt     DateTime?
  // progress + counts (progress itself = business_research rows for this run)
  totalCount     Int                @default(0)
  processedCount Int                @default(0)
  okCount        Int                @default(0)
  noWebsiteCount Int                @default(0)
  brokenCount    Int                @default(0)
  blockedCount   Int                @default(0)
  errorCount     Int                @default(0) // provider failures (ok:false) per business
  factCount      Int                @default(0) // facts written (created or refreshed)
  newFactCount   Int                @default(0)
  conflictCount  Int                @default(0) // businesses with >= 1 conflicting field after research
  requestCount   Int                @default(0)
  attempts       Int                @default(0)
  error          String?
  errors         Json? // last per-business errors [{businessId, error}] (capped)
  // who and when
  startedById    String?
  startedBy      User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedByLabel String
  lockedBy       String?
  lockedAt       DateTime?
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime           @updatedAt
  results        BusinessResearch[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("research_run")
}

/// Outcome of researching one business in one run. Observations only: no score (Phase 5).
model BusinessResearch {
  id             String      @id @default(uuid())
  runId          String
  run            ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider       String
  status         String // ok | no_website | broken | blocked | error
  httpStatus     Int?
  requestedUrl   String?
  finalUrl       String?
  signals        Json? // WebsiteSignals (packages/core/src/research.ts)
  summary        String? // plain-language, score-free
  factCount      Int         @default(0)
  conflictFields String[]    @default([])
  requestCount   Int         @default(0)
  error          String?
  researchedAt   DateTime    @default(now())

  @@unique([runId, businessId])
  @@index([businessId, researchedAt])
  @@index([status])
  @@map("business_research")
}

/// One value about a business with full provenance. Listing values (OSM / discovery record) are
/// stored as facts too (sourceType osm|listing) so every value has the same provenance shape.
model ResearchFact {
  id                   String        @id @default(uuid())
  businessId           String
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  field                String // ResearchField: phone, email, social_facebook, opening_hours ...
  value                String // as found, <= 1000 chars
  normalizedValue      String // comparison key, <= 400 chars
  // provenance
  sourceUrl            String // <= 500 chars
  sourceType           String // jsonld | microdata | meta | html | header | robots | osm | listing | mock
  provider             String // provider that produced it: http-extractor | osm-overpass | ...
  collectedAt          DateTime // latest time this value was seen at sourceUrl
  confidence           Float // extraction-method reliability 0..1, NOT a verification
  verificationStatus   String        @default("unverified") // unverified | verified | conflicting | invalid
  usageRestriction     String?
  firstRunId           String?
  lastRunId            String?
  // Phase 5 verification: how and when the status was set, with evidence
  verifiedAt           DateTime? // last time the status was (re)assessed, automatically or by a person
  verificationMethod   String? // phone_format_agreement | email_syntax_mx | website_reachability | postcode_format_state | conflict_check | manual
  verificationEvidence Json?
  verificationOverride Boolean       @default(false) // set by a person: the automatic pass leaves it alone
  verifiedById         String?
  verifiedBy           User?         @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedByLabel      String? // email or "system"; survives user deletion
  overrideReason       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  leadContacts         LeadContact[]

  @@unique([businessId, field, normalizedValue, sourceUrl])
  @@index([businessId, field])
  @@index([field, verificationStatus])
  @@map("research_fact")
}

// ---------- Phase 5: verification and qualification ----------

enum QualificationRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

/// One verification + qualification job; also the worker's queue (job type "qualification", same
/// claim mechanism as research_run). Per business: verify facts, score with rules, optional AI.
model QualificationRun {
  id                 String                  @id @default(uuid())
  status             QualificationRunStatus  @default(queued)
  idempotencyKey     String?                 @unique
  scopeType          String // businesses | discovery_run | research_run | filter
  businessIds        String[]                @default([])
  discoveryRunId     String?
  researchRunId      String?
  filter             Json?
  targetIds          String[]                @default([])
  resolvedAt         DateTime?
  // AI step (optional): provider descriptor id or null when rules-only
  aiEnabled          Boolean                 @default(false)
  aiProvider         String? // mock-model | ollama | gemini
  promptVersion      String?
  rulesVersion       String
  // progress + counts (progress itself = business_qualification rows for this run)
  totalCount         Int                     @default(0)
  processedCount     Int                     @default(0)
  hotCount           Int                     @default(0)
  warmCount          Int                     @default(0)
  coldCount          Int                     @default(0)
  disqualifiedCount  Int                     @default(0)
  errorCount         Int                     @default(0)
  factsCheckedCount  Int                     @default(0)
  factsVerifiedCount Int                     @default(0)
  factsInvalidCount  Int                     @default(0)
  dnsLookupCount     Int                     @default(0)
  aiOkCount          Int                     @default(0)
  aiErrorCount       Int                     @default(0)
  aiInputTokens      Int                     @default(0)
  aiOutputTokens     Int                     @default(0)
  aiCostMinor        Int                     @default(0)
  attempts           Int                     @default(0)
  error              String?
  errors             Json?
  startedById        String?
  startedBy          User?                   @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedByLabel     String
  lockedBy           String?
  lockedAt           DateTime?
  createdAt          DateTime                @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  updatedAt          DateTime                @updatedAt
  results            BusinessQualification[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("qualification_run")
}

/// Qualification of one business in one run. score/tier come only from the rules; AI suggestions
/// (summary, pitch, risks) are stored beside them and never change the score.
model BusinessQualification {
  id                 String           @id @default(uuid())
  runId              String
  run                QualificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rulesVersion       String
  score              Int // 0..100
  tier               String // hot | warm | cold | disqualified
  components         Json // {website, contact, category}
  reasons            Json // [{code, kind, points, text, factIds[], researchId?}]
  disqualifiedReason String? // closed | no_contact_channel | duplicate | blocked_category
  duplicateOfId      String?
  operatingStatus    String // closed | possibly_closed | no_evidence
  verification       Json // summary counts of the verification pass
  researchId         String? // business_research the website reasons rest on
  isMock             Boolean          @default(false)
  // optional AI suggestions (null when AI was off, skipped or failed)
  aiStatus           String           @default("off") // off | skipped | ok | error
  aiSummary          String?
  aiPitch            String?
  aiRisks            Json?
  aiError            String?
  aiProvider         String?
  aiModel            String?
  aiPromptVersion    String?
  aiInputTokens      Int?
  aiOutputTokens     Int?
  aiCostMinor        Int?
  aiIsMock           Boolean          @default(false)
  qualifiedAt        DateTime         @default(now())

  @@unique([runId, businessId])
  @@index([businessId, qualifiedAt])
  @@index([tier, score])
  @@map("business_qualification")
}

// ---------- Phase 6: CRM and lead management ----------

enum LeadStage {
  new
  contacted
  interested
  demo_requested
  proposal_sent
  negotiating
  won
  lost
  nurture
}

enum LeadPriority {
  low
  normal
  high
}

enum LeadSource {
  qualification
  manual
  import
}

enum LeadActivityType {
  note
  call_logged
  meeting_logged
  stage_change
  assignment
  task_done
  system
}

enum LeadTaskStatus {
  open
  done
  cancelled
}

enum ContactStatus {
  ok
  do_not_contact
  opted_out
}

/// One sales lead per business. Stage rules live in packages/core/src/crm.ts; every write that
/// changes the row bumps `version` (optimistic concurrency: a stale version is a 409).
model Lead {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage              LeadStage          @default(new)
  assigneeId         String?
  assignee           User?              @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority           LeadPriority       @default(normal)
  valueEstimatePaise Int? // estimate only, in paise; never a price list
  currency           String             @default("INR")
  lostReason         String? // required while stage = lost (CHECK)
  nextFollowUpAt     DateTime?
  source             LeadSource
  qualificationId    String? // business_qualification it was promoted from (plain id)
  promotedTier       String? // tier at promotion: hot | warm | cold
  createdById        String?
  createdBy          User?              @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByLabel     String // email or "system"
  lastActivityAt     DateTime           @default(now())
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  stageChangedAt     DateTime           @default(now())
  stageHistory       LeadStageHistory[]
  contacts           LeadContact[]
  activities         LeadActivity[]
  tasks              LeadTask[]
  tags               LeadTagLink[]

  @@index([stage, assigneeId])
  @@index([assigneeId])
  @@index([nextFollowUpAt])
  @@index([lastActivityAt])
  @@index([createdAt])
  @@map("lead")
}

/// Append-only (trigger): rows leave only with their lead.
model LeadStageHistory {
  id        String     @id @default(uuid())
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage LeadStage? // null for the first entry
  toStage   LeadStage
  byId      String?
  by        User?      @relation(fields: [byId], references: [id], onDelete: SetNull)
  byLabel   String
  at        DateTime   @default(now())
  note      String?

  @@index([leadId, at])
  @@map("lead_stage_history")
}

/// A person or channel at the business. sourceFactId links the research fact a value came from.
model LeadContact {
  id           String        @id @default(uuid())
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  personName   String?
  role         String?
  phone        String?
  email        String?
  whatsapp     String?
  isPrimary    Boolean       @default(false)
  sourceFactId String?
  sourceFact   ResearchFact? @relation(fields: [sourceFactId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([leadId])
  @@map("lead_contact")
}

/// Timeline. Append-only (trigger) except a note's body, editable by its author for 15 minutes.
model LeadActivity {
  id          String           @id @default(uuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorLabel String
  body        String
  metadata    Json?
  createdAt   DateTime         @default(now())
  editedAt    DateTime?

  @@index([leadId, createdAt])
  @@map("lead_activity")
}

model LeadTask {
  id               String         @id @default(uuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title            String
  dueAt            DateTime?
  assigneeId       String?
  assignee         User?          @relation("LeadTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status           LeadTaskStatus @default(open)
  createdById      String?
  createdBy        User?          @relation("LeadTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByLabel   String
  completedAt      DateTime?
  completedById    String?
  completedBy      User?          @relation("LeadTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  completedByLabel String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Open tasks by due date: partial index lead_task_open_due_idx (raw SQL in the migration).
  @@index([leadId, status])
  @@index([assigneeId, status])
  @@map("lead_task")
}

/// Tags are unique case-insensitively: key = lower(trim(name)) (CHECK + unique).
model LeadTag {
  id        String        @id @default(uuid())
  name      String
  key       String        @unique
  createdAt DateTime      @default(now())
  leads     LeadTagLink[]

  @@map("lead_tag")
}

model LeadTagLink {
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId     String
  tag       LeadTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([leadId, tagId])
  @@index([tagId])
  @@map("lead_tag_link")
}
